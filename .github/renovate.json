{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "schedule": ["at any time"],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "labels": ["dependencies"],
  "assignees": ["ZM-BAD"],
  "recreateClosed": false,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["ZM-BAD"]
  },
  "packageRules": [
    {
      "description": "All updates auto-create PR, no dashboard approval needed",
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Python production dependencies",
      "matchFileNames": ["backend/requirements.txt"],
      "groupName": "Python dependencies"
    },
    {
      "description": "Python development dependencies",
      "matchFileNames": ["backend/requirements-dev.txt"],
      "groupName": "Python dev dependencies"
    },
    {
      "description": "Pre-commit hooks",
      "matchManagers": ["pre-commit"],
      "groupName": "Pre-commit hooks"
    },
    {
      "description": "Frontend dependencies",
      "matchFileNames": ["frontend/package.json"],
      "groupName": "Frontend dependencies"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Node.js version",
      "matchManagers": ["node"],
      "groupName": "Node.js"
    }
  ],
  "automerge": false,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "constraints": {
    "python": ">=3.14",
    "node": ">=20"
  }
}

{
  "compilerOptions": {
    // Target ESNext (TypeScript 6). The runtime/emit target is controlled separately by
    // Vite's build.target in vite.config.ts (this project uses noEmit). See specs/230-frontend-typescript-toolchain.md.
    "target": "ESNext",
    "lib": ["dom", "ESNext"],
    // @types packages are no longer auto-discovered in TypeScript 6 (default `types: []`).
    // Declared explicitly to lock the behavior and speed up type-checking; add entries
    // here only if ambient globals (e.g. "node") are needed. See specs/230-frontend-typescript-toolchain.md.
    "types": [],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // React 19 specific
    "jsxImportSource": "react",
    // Enhanced type checking
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

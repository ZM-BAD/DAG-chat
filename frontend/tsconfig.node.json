{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    // This project type-checks vite.config.ts, which runs in Node — declare node types explicitly.
    "types": ["node"],
    "module": "esnext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "composite": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": ["vite.config.ts"]
}

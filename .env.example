# DAG-chat configuration — single source of truth for the entire project.
# Copy this file to .env and fill in your values.

# Default User ID (used by both frontend and backend)
DEFAULT_USER_ID=default-user

# Frontend only (VITE_ prefix — not read by backend)
VITE_API_BASE_URL=http://localhost:8000

# LLM API Keys
GLM_API_KEY=your_glm_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here

# LLM Model Names (uncomment to override defaults)
# GLM_MODEL=glm-5
# KIMI_MODEL=kimi-k2.6
# KIMI_TITLE_MODEL=moonshot-v1-8k
# QWEN_MODEL_THINKING=qwen-plus
# QWEN_MODEL=qwen3-max
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_THINKING_EFFORT=high
# MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Ollama Configuration (local LLM, no API key needed)
# Uncomment and modify if Ollama is running on a non-default address
# OLLAMA_API_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# MySQL Configuration
MYSQL_PASSWORD=your_mysql_password_here
